# Admin Management Password for EternalVows
# Set this in your Vercel Project Settings -> Environment Variables
ADMIN_PASSWORD=VowsAdmin@2026

# Studio Owner Contact (For WhatsApp and Email Leads)
NEXT_PUBLIC_OWNER_PHONE=919876543210
NEXT_PUBLIC_OWNER_EMAIL=studio@eternalvows.com

# Permanent Cloud Database (Optional - Vercel KV / Upstash Redis)
# Automatically provided if you add Vercel KV from the Storage tab in Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or directly from upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Instant Notifications (Optional - Discord, Slack, Zapier Webhook)
NOTIFICATION_WEBHOOK_URL=
